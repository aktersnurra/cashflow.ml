card.invitation.title = {$household} har bjudit in dig
card.invitation.body = Gå med för att se och dela hushållets konton.
card.mismatch.title = {$account} skiljer {$difference :currency}
card.mismatch.body = Banken angav {$statement :currency} den {$date :date}; bokföringen säger {$ledger :currency}.
card.import.title = Dags att importera {$account}
card.import.never = Inget kontoutdrag importerat än. Ladda ner transaktionslistan från banken (Excel eller CSV) och släpp den här.
card.import.days =
  .input {$days :integer}
  .match $days
  one {{Senaste importen var i går.}}
  * {{Senaste importen var för {$days} dagar sedan.}}
card.import.drop = Välj bankens Excel- eller CSV-fil, eller släpp den här
card.import.reading = Läser {$file}…
card.import.new =
  .input {$count :integer}
  .match $count
  one {{1 ny transaktion}}
  * {{{$count} nya transaktioner}}
card.import.duplicates =
  .input {$count :integer}
  .match $count
  one {{1 redan importerad}}
  * {{{$count} redan importerade}}
card.import.matched =
  .input {$count :integer}
  .match $count
  one {{1 bekräftar en post du lagt in}}
  * {{{$count} bekräftar poster du lagt in}}
card.import.ambiguous =
  .input {$count :integer}
  .match $count
  one {{1 rad ser ut som en som redan är importerad: samma dag, text och belopp. Är den det?}}
  * {{{$count} rader ser ut som sådana som redan är importerade: samma dag, text och belopp. Är de det?}}
card.import.opening = Inget är bokfört före den här filen. Enligt bankens saldo fanns {$balance :currency} på kontot den {$date :date}.
card.import.balance_ok = Saldot kommer att stämma med banken: {$balance :currency}.
card.import.balance_off = Bokföringen skulle skilja {$difference :currency} från bankens {$balance :currency}.
card.import.already = Den här filen är redan importerad.
card.import.done =
  .input {$count :integer}
  .match $count
  0 {{Importerat. Allt är kategoriserat.}}
  one {{Importerat. 1 transaktion att granska.}}
  * {{Importerat. {$count} transaktioner att granska.}}
card.inbox.title =
  .input {$count :integer}
  .match $count
  one {{1 transaktion att kategorisera}}
  * {{{$count} transaktioner att kategorisera}}
card.inbox.body = Förslagen är klara; de flesta tar en knapptryckning.
card.unmatched.title = Inte på kontoutdraget: {$description}
card.unmatched.body = Du lade in {$amount :currency} den {$date :date}, men bankens kontoutdrag visar den inte.
card.review.title = Så gick {$month}
card.budget.over = {$category} är över budget
card.budget.ahead = {$category} går fortare än planerat
card.budget.body = {$spent :currency} av {$budget :currency}; i jämn takt vore det {$expected :currency} i dag.
card.contributions.title = Din överföring till hushållet
card.contributions.body = {$remaining :currency} kvar att föra över av {$contribution :currency} den här månaden.
card.settle.title = Hushållet är skyldigt {$name} {$amount :currency}
card.cash.title = Räkna kontanterna i {$account}
card.cash.body = Inga kontantutgifter inlagda sedan {$since :date}.
card.goal.title = {$goal} halkar efter
card.goal.body = {$saved :currency} av {$target :currency}. Lägg undan {$required :currency} i månaden för att nå målet.
card.recurring.changed = {$merchant} gick från {$previous :currency} till {$last :currency}
card.recurring.new = Ny återkommande betalning ({$cadence}): {$merchant}
card.shortfall.title = {$account} kan bli kort före lönen
