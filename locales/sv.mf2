  .input {$days :integer}
  .match $days
  one {{Vanlig konsumtion bygger bara på 1 dag.}}
  * {{Vanlig konsumtion bygger bara på {$days} dagar.}}
forecast.a.no_history = Ingen konsumtionshistorik än, så ingen räknas in.
forecast.a.no_income = Ingen regelbunden inkomst hittad, så ingen räknas in.
forecast.a.cards = Kortköp når dina pengar när kortfakturan betalas.
forecast.money_out = Pengar ut
forecast.money_in = Pengar in
forecast.overdraw_spending = Lägst {$amount :currency} den {$date :date}, av vanlig konsumtion.
action.see_forecast = Se prognos
forecast.legend_projected = Beräknat saldo
