card.missing_income.title = {$name} ({$amount :currency}) hasn't come in
card.missing_income.body = It was expected around {$date :date}, and your statements reach past that. Paid into another account, or late?
card.missing_bill.title = No payment to {$name} ({$amount :currency}) since it was due
card.missing_bill.body = It usually comes {$cadence} and was due around {$date :date}. Paid another way, or missed?
card.double_charge.title = {$merchant} charged {$amount :currency} twice
card.double_charge.body = On {$first :date} and {$second :date}. If one is a mistake, ask them to refund it.
card.yearly_bill.title = {$name} is due around {$date :date}
card.yearly_bill.body = It comes once a year: {$amount :currency} last time, on {$last :date}. Worth setting aside for.
card.large_purchase.title = Your biggest purchase in half a year
card.large_purchase.body = {$amount :currency} at {$description} on {$date :date}, more than twice anything else; the largest before it was {$before :currency}.
