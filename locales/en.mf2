forecast.on = on {$date :date}
forecast.before_salary = Before next salary
forecast.no_salary = No regular salary found
forecast.due_before_salary = Due before salary
forecast.due_next_month = Due in the next month
forecast.payments =
  .input {$count :integer}
  .match $count
  one {{1 payment}}
  * {{{$count} payments}}
forecast.end = On {$date :date}
forecast.overdraw = {$account} goes below zero on {$date :date}
forecast.overdraw_body = Lowest {$amount :currency} on {$date :date}, after {$items}.
forecast.upcoming = Upcoming
forecast.no_series = No regular payments found yet. They show up after three of the same.
forecast.cadence.weekly = Weekly
forecast.cadence.monthly = Monthly
forecast.cadence.quarterly = Quarterly
forecast.cadence.yearly = Yearly
forecast.basis = {$cadence} since {$since :date}, usually {$typical :currency}, last {$last :currency}.
