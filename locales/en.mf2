signin.title = Your money, at a glance
signin.body = Sign in with your Pocket ID account to see your accounts, spending and savings.

card.invitation.title = {$household} invited you
card.invitation.body = Join to see and share the household's accounts.
card.mismatch.title = {$account} is {$difference :currency} off
card.mismatch.body = The bank said {$statement :currency} on {$date :date}; the ledger says {$ledger :currency}.
card.import.title = Time to import {$account}
card.import.never = No statement imported yet. Download the transaction list from your bank (Excel or CSV) and drop it here.
card.import.days =
  .input {$days :integer}
  .match $days
  one {{Last import was yesterday.}}
  * {{Last import was {$days} days ago.}}
card.import.drop = Choose the bank's Excel or CSV file, or drop it here
card.import.reading = Reading {$file}…
card.import.new =
  .input {$count :integer}
  .match $count
  one {{1 new transaction}}
  * {{{$count} new transactions}}
card.import.duplicates =
  .input {$count :integer}
  .match $count
  one {{1 already imported}}
  * {{{$count} already imported}}
card.import.matched =
  .input {$count :integer}
  .match $count
  one {{1 confirms an entry you made}}
  * {{{$count} confirm entries you made}}
card.import.ambiguous =
  .input {$count :integer}
  .match $count
  one {{1 row looks like one already imported: the same day, text and amount. Is it?}}
  * {{{$count} rows look like ones already imported: the same day, text and amount. Are they?}}
card.import.opening = Nothing is recorded before this file. The bank's balance says the account held {$balance :currency} on {$date :date}.
card.import.balance_ok = The balance will match the bank: {$balance :currency}.
card.import.balance_off = The ledger would be {$difference :currency} off from the bank's {$balance :currency}.
card.import.already = This file was already imported.
card.import.done =
  .input {$count :integer}
  .match $count
  0 {{Imported. Everything is categorised.}}
  one {{Imported. 1 transaction to review.}}
  * {{Imported. {$count} transactions to review.}}
card.inbox.title =
  .input {$count :integer}
  .match $count
  one {{1 transaction to categorise}}
  * {{{$count} transactions to categorise}}
card.inbox.body = Suggestions are ready; most take one keystroke.
card.unmatched.title = Not on the statement: {$description}
card.unmatched.body = You entered {$amount :currency} on {$date :date}, but the bank's statement doesn't show it.
card.review.title = How {$month} went
brief.title = Last week, {$first :date} to {$last :date}
brief.top = Most spent on
brief.before = The week before: {$amount :currency} spent.
brief.upcoming = Expected in the next seven days: {$amount :currency} in recurring payments.
brief.writing = Writing a summary…
card.budget.over = {$category} is over budget
card.budget.ahead = {$category} is ahead of pace
card.budget.body = {$spent :currency} of {$budget :currency}; pace expects {$expected :currency} by today.
card.contributions.title = Your household transfer
card.contributions.body = {$remaining :currency} left to transfer of {$contribution :currency} this month.
card.settle.title = The household owes {$name} {$amount :currency}
card.cash.title = Count the cash in {$account}
card.cash.body = No cash spending entered since {$since :date}.
card.goal.title = {$goal} is falling behind
card.goal.body = {$saved :currency} of {$target :currency}. Set aside {$required :currency} a month to make it.
card.recurring.changed = {$merchant} went from {$previous :currency} to {$last :currency}
card.recurring.new = New {$cadence} payment: {$merchant}
card.shortfall.title = {$account} may run short before payday
card.shortfall.body = {$due :currency} in bills is still due and {$available :currency} is left, {$short :currency} short.
card.shortfall.item = {$merchant}, {$amount :currency} around {$date :date}
card.unusual.title = {$category} is higher than usual
card.unusual.body = {$spent :currency} so far this cycle; a whole cycle usually costs {$usual :currency}.
card.overview.title = {$month} so far

