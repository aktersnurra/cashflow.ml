(rule
 (alias check-library-boundaries)
 (enabled_if (= %{context_name} default))
 (deps check_library_boundaries.py test_check_library_boundaries.py (source_tree ../lib)
  ../bin/dune ../shared/mf2/dune ../tools/mf2c/dune ../locales/dune ../web/dune dune)
 (action
  (progn
   (chdir .. (run python3 test/check_library_boundaries.py))
   (run python3 test_check_library_boundaries.py))))

(alias
 (name runtest)
 (enabled_if (= %{context_name} default))
 (deps (alias check-library-boundaries)))
