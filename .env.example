# Local SQLite database on a ZFS dataset mounted in the FreeBSD jail (never NFS).
CASHFLOW_DATABASE_PATH=/var/db/cashflow/cashflow.sqlite3
# Private listener; Caddy is the only public TLS endpoint.
CASHFLOW_LISTEN_ADDRESS=127.0.0.1:8081
CASHFLOW_PUBLIC_BASE_URL=https://cashflow.example.com
# Pocket ID issuer, and the audience MCP bearer tokens must carry.
CASHFLOW_OIDC_ISSUER=https://id.example.com
CASHFLOW_OIDC_AUDIENCE=https://cashflow.example.com
# The web UI's confidential OIDC client in Pocket ID. Its callback URL is
# $CASHFLOW_PUBLIC_BASE_URL/auth/callback. Leave both empty to serve only MCP.
CASHFLOW_WEB_CLIENT_ID=
CASHFLOW_WEB_CLIENT_SECRET=
# Members of this Pocket ID group are admins: they create households and add shared accounts.
CASHFLOW_ADMIN_GROUP=cashflow-admin
# Where the built web UI (index.html, assets/) is installed.
CASHFLOW_STATIC_DIR=/usr/local/share/cashflow/web
# Optional: category suggestions and month summaries through OpenRouter.
CASHFLOW_OPENROUTER_API_KEY=
CASHFLOW_OPENROUTER_MODEL=anthropic/claude-haiku-5.5
