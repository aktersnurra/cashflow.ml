; The Bonsai web UI, compiled to JavaScript in the cashflow-web switch:
;   dune build --workspace dune-workspace.web @web/default
(executable
 (name main)
 (enabled_if (= %{context_name} web))
 (modes js)
 (libraries bonsai.web bonsai.feather_icon async_js virtual_dom virtual_dom.svg js_of_ocaml yojson cmarkit cashflow_msg mf2_runtime cashflow_advisor_protocol cashflow_advisor_stream)
 (preprocess (pps ppx_jane bonsai.ppx_bonsai js_of_ocaml-ppx)))

(rule
 (alias default)
 (enabled_if (= %{context_name} web))
 (targets index.html)
 (deps index.src.html main.bc.js style.css manifest.webmanifest
       apple-touch-icon.png favicon-16.png favicon-32.png favicon-48.png favicon.ico
       icon-64.png icon-192.png icon-512.png icon-maskable-512.png)
 (action
  (with-stdout-to index.html
   (run %{bin:ocaml} %{dep:build/version_assets.ml} %{dep:index.src.html} %{dep:style.css} %{dep:main.bc.js}))))
